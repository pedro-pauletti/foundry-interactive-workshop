# =====================================================================
# Setup .env — used by the notebooks under infra/scripts/
# (For the runtime web app, see src/app/webApp/example.env)
# =====================================================================
#
# Authentication: keyless / Entra ID (DefaultAzureCredential).
# Sign in once with `az login` (or use VS Code Azure Account / Managed Identity).
#
# RBAC required on the SIGNED-IN identity:
#   - Azure AI Search:        "Search Service Contributor" + "Search Index Data Contributor"
#   - Azure AI Foundry/AOAI:  "Cognitive Services OpenAI User" + "Azure AI User"
#   - Foundry Project:        "Azure AI Project Manager" (to create agents)
#   - Log Analytics:          "Log Analytics Reader" (for the dashboard demo)
#   - Application Insights:   "Monitoring Reader"
#
# RBAC required on the AI SEARCH service's system-assigned managed identity:
#   - Azure AI Foundry/AOAI:  "Cognitive Services OpenAI User"  (runtime vectorizer)
#
# RBAC required on the FOUNDRY project's system-assigned managed identity:
#   - Azure AI Search:        "Search Index Data Reader"  (Foundry IQ knowledge bases)
#
# =====================================================================
# Resource names (already provisioned)
# =====================================================================
# Foundry        : foundry-ai-framework
# Foundry project: proj-ai-framework
# AI Search      : ai-search-ai-framework
# App Insights   : ai-framework-app-insights
# APIM AI Gateway: ai-framework-gateway
# Log Analytics  : law-framework-ai
# =====================================================================

# ====== Azure subscription (used by az CLI helpers) ======
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_RESOURCE_GROUP=<your-resource-group>
AZURE_LOCATION=eastus2

# ====== Azure AI Search ======
AZURE_SEARCH_ENDPOINT=https://ai-search-ai-framework.search.windows.net
AZURE_SEARCH_INDEX_TELECOM=telecom-products
AZURE_SEARCH_INDEX_REGULATIONS=internal-regulations

# ====== Azure OpenAI / Foundry inference endpoint (embeddings + chat) ======
# This is the AOAI-compatible endpoint of the Foundry account.
AZURE_OPENAI_ENDPOINT=https://foundry-ai-framework.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_CHAT_MODEL=gpt-4o-mini

# ====== Microsoft Foundry project (agents) ======
# Endpoint shown on the Foundry project's Overview page.
AZURE_AI_PROJECT_ENDPOINT=https://foundry-ai-framework.services.ai.azure.com/api/projects/proj-ai-framework

# Names of the agents created by provision_agents.ipynb
AZURE_AI_AGENT_ORCHESTRATOR=orquestrador-atendimento
AZURE_AI_AGENT_PRODUTOS=especialista-produtos
AZURE_AI_AGENT_REGULAMENTOS=especialista-regulamentos
AZURE_AI_AGENT_SUPORTE=especialista-suporte-tecnico
AZURE_AI_AGENT_VENDAS=especialista-vendas

# ====== Application Insights (tracing + dashboards) ======
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<key>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/
APP_INSIGHTS_RESOURCE_NAME=ai-framework-app-insights

# ====== Log Analytics Workspace (for AI Gateway dashboard demo) ======
LOG_ANALYTICS_WORKSPACE_NAME=law-framework-ai
LOG_ANALYTICS_WORKSPACE_ID=<workspace-guid>

# ====== APIM / AI Gateway ======
APIM_SERVICE_NAME=ai-framework-gateway
APIM_GATEWAY_ENDPOINT=https://ai-framework-gateway.azure-api.net
APIM_SUBSCRIPTION_KEY=<apim-subscription-key>

# ====== Image generation (used by imagecreation.ipynb) ======
AZURE_AI_IMAGE_ENDPOINT=https://foundry-ai-framework.openai.azure.com/openai/v1
AZURE_AI_IMAGE_DEPLOYMENT=gpt-image-2-1

# ====== Sample data ======
SAMPLE_DATA_DIR_TELECOM=../../data/indexsampledata/telecom-products
SAMPLE_DATA_DIR_REGULATIONS=../../data/indexsampledata/internal-regulations

# ====== Hosted Agents (deploy_hosted_agents.ipynb) ======
# Login server do ACR usado para hospedar as imagens dos agentes
# (mafw-contoso, langgraph-contoso) que rodarão dentro do Foundry Agent Service.
# Provisionado em rg-framework-ai-contoso. A managed identity do projeto Foundry
# precisa de "AcrPull" neste registry; a sua identidade precisa de "AcrPush".
ACR_LOGIN_SERVER=acrframeworkaicontoso.azurecr.io
HOSTED_TAG=v1
