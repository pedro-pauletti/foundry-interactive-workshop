# Configuração do web app do Workshop Framework IA Contoso
APP_TITLE=Mapeamento Requisitos Contoso x Stack Microsoft
APP_TAGLINE=Os 24 requisitos do Framework IA Contoso e como cada um é endereçado pela stack Microsoft

# Telemetria opcional
APPINSIGHTS_CONNECTION_STRING=

# ====== Microsoft Foundry agent (live demo de chat RAG na seção "Ato 1 · RAG com Foundry IQ") ======
# Endpoint do projeto Foundry (visível no Overview do projeto).
# Formato: https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# Nome do agente publicado no Foundry que será invocado pelo chat.
AZURE_AI_AGENT_NAME=contoso-knowledge-curator

# ====== Hosted Agents (seção "Construir · Hosted Agents") ======
# Nomes dos Hosted Agents publicados no Foundry pelo notebook
# infra/scripts/deploy_hosted_agents.ipynb. São o MESMO código local de
# src/app/mafwAgent e src/app/langgraphAgent empacotado em container e
# rodando dentro do Foundry Agent Service.
AZURE_AI_HOSTED_MAFW=mafw-contoso
AZURE_AI_HOSTED_LANGGRAPH=langgraph-contoso
# URLs dos containers locais (já apontadas pelo docker-compose).
MAFW_AGENT_URL=http://mafw-agent:8091
LANGGRAPH_AGENT_URL=http://langgraph-agent:8090
# ACR usado pelo deploy notebook (login server, ex: myacr.azurecr.io).
ACR_LOGIN_SERVER=

# ====== Observabilidade em Produção (seção "Ato 3 · Observabilidade") ======
# Application Insights — connection string (Portal → AI resource → Overview).
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Log Analytics Workspace usado pelos Diagnostic Settings do Foundry/APIM.
# Workspace ID = GUID em "law-* → Properties → Workspace ID".
LOG_ANALYTICS_WORKSPACE_ID=
LOG_ANALYTICS_WORKSPACE_NAME=law-framework-ai
# APIM AI Gateway que serve de proxy/observabilidade para os LLMs.
APIM_GATEWAY_NAME=ai-framework-gateway
APIM_GATEWAY_URL=https://<your-apim>.azure-api.net
APIM_SUBSCRIPTION_KEY=
# Subscription / RG (usados em links "abrir no portal").
AZURE_RESOURCE_GROUP=rg-framework-ai-contoso
AZURE_SUBSCRIPTION_ID=
