def _code_block(lang: str, code: str, caption: str = "") -> str:
    import html as _html
    safe = _html.escape(code)
    cap = f'<div class="code-caption">{caption}</div>' if caption else ""
    return f'{cap}<pre class="code-block"><code class="language-{lang}">{safe}</code></pre>'


# ---------------------------------------------------------------------------
# Code samples — Agent 365 SDK (Python) & app registration
# Refs:
#   https://learn.microsoft.com/en-us/microsoft-agent-365/developer/agent-365-sdk?tabs=python
#   https://learn.microsoft.com/en-us/microsoft-agent-365/developer/custom-client-app-registration
#   https://learn.microsoft.com/en-us/microsoft-agent-365/developer/get-started
# ---------------------------------------------------------------------------
INSTALL_SDK = '''pip install microsoft-agent365'''

REGISTER_AGENT_PY = '''# Registrar o agente no Agent 365 (one-time)
from microsoft_agent365 import AgentClient
from azure.identity import DefaultAzureCredential

client = AgentClient(credential=DefaultAzureCredential())

agent = client.agents.create(
    display_name="Curador de Conhecimento Contoso",
    description="Responde dúvidas internas com base na documentação corporativa.",
    publisher="Contoso",
    # Endpoint de runtime — Foundry Hosted Agent OU URL HTTPS própria.
    endpoint={
        "type": "foundry_hosted",
        "foundry_agent_id": "asst_xxxxxxxxxxxxxxxx",
        "project_endpoint": "https://<projeto>.services.ai.azure.com/api/projects/<projeto>",
    },
    # App registration que representa o agente no Entra (ver passo 2).
    client_app_id="<application-id-do-app-registration>",
    # Capacidades que o agente expõe ao Microsoft 365.
    capabilities=["chat", "search", "actions"],
)
print("Agente registrado em Agent 365:", agent.id)
'''

INVOKE_PY = '''# Conversar com o agente via Agent 365 SDK
from microsoft_agent365 import AgentClient
from azure.identity import DefaultAzureCredential

client = AgentClient(credential=DefaultAzureCredential())

conv = client.conversations.create(agent_id=agent.id)
client.messages.send(
    conversation_id=conv.id,
    content="Quais planos de fibra para home office?",
)

for msg in client.messages.list(conversation_id=conv.id):
    print(msg.role, "→", msg.content)
'''

APP_REGISTRATION_BICEP = '''// app-registration.bicep — App registration mínima para Agent 365
// Refs: learn.microsoft.com/.../custom-client-app-registration
resource agentApp 'Microsoft.Graph/applications@v1.0' = {
  uniqueName: 'curador-contoso-agent'
  displayName: 'Curador de Conhecimento Contoso'
  signInAudience: 'AzureADMyOrg'
  api: {
    requestedAccessTokenVersion: 2
  }
  requiredResourceAccess: [
    {
      // Microsoft Graph
      resourceAppId: '00000003-0000-0000-c000-000000000000'
      resourceAccess: [
        // openid / profile / offline_access — login do usuário
        { id: '37f7f235-527c-4136-accd-4a02d197296e', type: 'Scope' }
        { id: '14dad69e-099b-42c9-810b-d002981feec1', type: 'Scope' }
        { id: '7427e0e9-2fba-42fe-b0c0-848c9e6a8182', type: 'Scope' }
      ]
    }
    {
      // Microsoft Agent 365 service
      resourceAppId: '<agent-365-service-app-id>'
      resourceAccess: [
        { id: '<scope-Agent.Invoke>', type: 'Scope' }
      ]
    }
  ]
}
'''


