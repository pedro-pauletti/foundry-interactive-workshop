        # ---------- BLOCO 3 — INTEGRATE, MANAGE & OPERATE ----------
        '<section class="card card--active" style="margin-top: 16px;">'
          '<div class="row" style="gap: 10px; margin-bottom: 14px;">'
            '<span class="card-icon" style="margin: 0;"><i class="fa-solid fa-gears"></i></span>'
