        '<span class="card-icon" style="margin: 0;"><i class="fa-solid fa-gears"></i></span>'
        '<div>'
          '<h3 class="card-title" style="margin: 0;">3. Integrate, Manage &amp; Operate · Take to production and keep it running</h3>'
