# ---------------------------------------------------------------------------
# Code samples
# ---------------------------------------------------------------------------
AGENT_YAML_SAMPLE = '''# contoso-knowledge-curator/agent.yaml
name: contoso-knowledge-curator
version: 3
model:
  id: gpt-4o
  parameters:
    temperature: 0.2
instructions: |
  Você é o curador de conhecimento Contoso. Responda APENAS com base
  no contexto fornecido. Se não houver evidência, diga
  "não encontrei na base" — nunca invente.
tools:
  - type: foundry_iq
    knowledge_source: contoso-docs-index
  - type: openapi
    name: customer_billing
    spec: ./tools/billing.openapi.yaml
'''

WORKFLOW_YAML_SAMPLE = '''# atendimento-contoso/workflow.yaml — Declarative agent workflow
name: atendimento-contoso
trigger:
  type: chat
nodes:
  - id: classify
    type: agent
    ref: classifier-agent           # decide: billing | support | sales
  - id: route
    type: switch
    on: ${{ classify.output.intent }}
    cases:
      billing: { next: billing_agent }
      support: { next: support_agent }
      sales:   { next: sales_agent }
  - id: billing_agent
    type: agent
    ref: contoso-billing-agent
  - id: support_agent
    type: agent
    ref: contoso-support-agent
  - id: sales_agent
    type: agent
    ref: contoso-sales-agent
'''


def _code_block(lang: str, code: str, caption: str = "") -> str:
    import html as _html
    safe = _html.escape(code)
    cap = f'<div class="code-caption">{caption}</div>' if caption else ""
    return f'{cap}<pre class="code-block"><code class="language-{lang}">{safe}</code></pre>'


