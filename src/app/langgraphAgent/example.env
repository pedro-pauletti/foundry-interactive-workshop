# Local agent — LangGraph (planner -> tool -> respond)
#
# Authentication: keyless / Entra ID (DefaultAzureCredential).
# Reuses the host `az login` cache mounted at /root/.azure.

# ====== Azure OpenAI / Foundry inference endpoint (chat) ======
AZURE_OPENAI_ENDPOINT=https://foundry-ai-framework.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini

# ====== Azure AI Search (used by the catalog tool) ======
AZURE_SEARCH_ENDPOINT=https://ai-search-ai-framework.search.windows.net
AZURE_SEARCH_INDEX_TELECOM=telecom-products

# Optional: turn on OpenTelemetry to App Insights (see local instrumentation)
APPLICATIONINSIGHTS_CONNECTION_STRING=
