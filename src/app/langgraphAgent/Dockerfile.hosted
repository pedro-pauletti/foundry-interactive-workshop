# LangGraph telecom agent — Foundry Hosted Agent variant.
# See ../mafwAgent/Dockerfile.hosted for the design rationale.
FROM --platform=linux/amd64 python:3.11-slim

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY src/app/langgraphAgent/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
 && pip install --no-cache-dir "azure-ai-agentserver-responses>=1.0.0b5" \
 && pip install --no-cache-dir --upgrade "fastapi>=0.118" \
 && pip install --no-cache-dir "httpx<0.28"

COPY src/app/langgraphAgent/app ./

EXPOSE 8088
CMD ["python", "-m", "responses_app"]
