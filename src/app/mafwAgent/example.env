# Local agent — Microsoft Agent Framework (orchestrator + 4 specialist sub-agents)

# ====== Azure OpenAI / Foundry inference endpoint (chat) ======
AZURE_OPENAI_ENDPOINT=https://foundry-ai-framework.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini

# ====== Azure AI Search (used by the specialists tools) ======
AZURE_SEARCH_ENDPOINT=https://ai-search-ai-framework.search.windows.net
AZURE_SEARCH_INDEX_TELECOM=telecom-products
AZURE_SEARCH_INDEX_REGULATIONS=internal-regulations

APPLICATIONINSIGHTS_CONNECTION_STRING=

# Microsoft Foundry — Hosted Agents invocados como tools pelo orquestrador MAF (A2A)
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_AGENT_VENDAS=especialista-vendas
AZURE_AI_AGENT_SUPORTE=especialista-suporte-tecnico
